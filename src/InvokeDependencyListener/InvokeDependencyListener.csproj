<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net40;net45;netstandard2.0;netstandard2.1</TargetFrameworks>
		<CheckNotRecommendedTargetFramework>false</CheckNotRecommendedTargetFramework>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<Authors>RzR</Authors>
		<Copyright>RzR</Copyright>
		<Owners>RzR</Owners>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageIcon>PackageIcon.png</PackageIcon>
		<NoWarn>$(NoWarn);CS8032</NoWarn>
		<EnableNETAnalyzers>false</EnableNETAnalyzers>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<PackageTags>Simple;DI;Dependency;Injection;Resolver;Instace;Code</PackageTags>
		<RepositoryUrl>https://github.com/I-RzR-I/InvokeDependencyListener</RepositoryUrl>
		<PackageProjectUrl>https://github.com/I-RzR-I/InvokeDependencyListener</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PackageDescription>A straightforward, lightweight, minimalistic implementation of Dependency Injection (DI) that avoids redundant class instance initialization and promotes a cleaner, more maintainable code.</PackageDescription>
		<Summary>A straightforward, lightweight, minimalistic implementation of Dependency Injection (DI) that avoids redundant class instance initialization and promotes a cleaner, more maintainable code.</Summary>
		<PackageTitle>RzR.Shared.Services (InvokeDependencyListener)</PackageTitle>
		<Title>RzR.Shared.Services (InvokeDependencyListener)</Title>
		<LangVersion>9.0</LangVersion>
		<Language>en-US</Language>
		<RepositoryType>GIT</RepositoryType>
		<PackageIconUrl />

		<RootNamespace>RzR.Infrastructure.DependencyResolver</RootNamespace>
		<AssemblyName>RzR.Infrastructure.DependencyResolver</AssemblyName>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\shared\GeneralAssemblyInfo.cs" Link="Properties\GeneralAssemblyInfo.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="..\..\assets\PackageIcon.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="RzR.Extensions.Domain" Version="7.1.0.5494" />
	</ItemGroup>

</Project>